<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>ddvs-modular-template-aspire-host</UserSecretsId>
    <IsTestProject>false</IsTestProject>
    <!-- Aspire injects OS-specific packages; one lock cannot cover every host. -->
