{
    "$schema": "http://json.schemastore.org/template",
    "author": "Reza Mashayekhi",
    "classifications": [
        "Web",
        "Web API",
        "API",
        "Service",
        "ASP.NET Core",
        "Minimal API",
        "DDD",
        "Vertical Slice",
        "Modular Monolith",
        "Clean Architecture",
        "Entity Framework Core",
        "SQLite",
        "Aspire",
        "Testing",
        "LLM-Friendly"
    ],
    "identity": "RM.DomainDrivenVerticalSlices.Template.Modular",
    "name": "Domain Driven Vertical Slices - Modular Monolith",
    "shortName": "ddvs-modular",
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "sourceName": "DomainDrivenVerticalSlices.Template",
    "preferNameDirectory": true,
    "symbols": {
        "Framework": {
            "type": "parameter",
            "datatype": "choice",
            "choices": [
                {
                    "choice": "net10.0",
                    "description": "Target .NET 10 (LTS)"
                },
                {
                    "choice": "net11.0",
                    "description": "Target .NET 11 (STS)"
                }
            ],
            "defaultValue": "net10.0",
            "replaces": "net10.0",
            "description": "Target framework for the generated solution"
        },
        "USE_NET11": {
            "type": "computed",
            "value": "(Framework == \"net11.0\")"
        },
        "SdkVersion": {
            "type": "generated",
            "generator": "switch",
            "replaces": "10.0.102",
            "parameters": {
                "evaluator": "C++",
                "datatype": "string",
                "cases": [
                    {
                        "condition": "USE_NET11",
                        "value": "11.0.100"
                    },
                    {
                        "condition": "",
                        "value": "10.0.102"
                    }
                ]
            }
        },
        "projectName": {
            "type": "parameter",
            "dataType": "string",
            "replaces": "DomainDrivenVerticalSlices.Template"
        },
        "UseAspire": {
            "type": "parameter",
            "datatype": "bool",
            "defaultValue": "true",
            "description": "Include .NET Aspire AppHost and ServiceDefaults projects"
        },
        "USE_ASPIRE": {
            "type": "computed",
            "value": "(UseAspire)"
        },
        "EXCLUDE_ASPIRE": {
            "type": "computed",
            "value": "(!UseAspire)"
        }
    },
    "sources": [
        {
            "source": "./",
            "target": "./",
            "exclude": [
                ".template.config/**",
                ".github/**",
                "docs/**",
                ".vs/**",
                "**/bin/**",
                "**/obj/**",
                "**/*.user",
                "**/*.lock.json"
            ],
            "modifiers": [
            {
                "condition": "(!USE_NET11)",
                "exclude": [
                    "Directory.Packages.net11.0.props"
                ]
            },
            {
                "condition": "(USE_NET11)",
                "exclude": [
                    "Directory.Packages.net10.0.props"
                ]
            },
                {
                    "condition": "(EXCLUDE_ASPIRE)",
                    "exclude": [
                        "src/DomainDrivenVerticalSlices.Template.AppHost/**",
                        "src/DomainDrivenVerticalSlices.Template.ServiceDefaults/**"
                    ]
                }
            ]
        }
    ]
}
