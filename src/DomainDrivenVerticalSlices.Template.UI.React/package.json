{
    "name": "react-app",
    "version": "10.8.0",
    "private": true,
    "type": "module",
    "dependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "prop-types": "^15.8.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router-dom": "^7.18.4",
        "web-vitals": "^5.3.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "coverage": "vitest run --coverage",
        "lint": "eslint \"src/**/*.{js,jsx}\" --max-warnings=0"
    },
    "jest": {
        "collectCoverageFrom": [
            "src/**/*.{js,jsx,ts,tsx}",
            "!src/**/*.d.ts",
            "!src/index.jsx",
            "!src/reportWebVitals.js",
            "!src/setupTests.js"
        ],
        "coverageReporters": [
            "lcov",
            "text"
        ],
        "coveragePathIgnorePatterns": [
            "/node_modules/",
            "/reportWebVitals.js",
            "/index.js"
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@headlessui/react": "^2.2.10",
        "@heroicons/react": "^2.2.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "@vitest/coverage-v8": "^4.1.11",
        "autoprefixer": "^10.6.1",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^16.5.0",
        "jsdom": "^26.1.0",
        "msw": "^2.15.0",
        "postcss": "^8.5.28",
        "tailwindcss": "^4.3.3",
        "vite": "^6.4.3",
        "vitest": "^4.1.11",
        "@eslint/js": "^9.39.5"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
        "npm": ">=10.0.0"
    },
    "overrides": {
        "minimatch": "10.2.3",
        "rollup": "4.60.0",
        "flatted": "3.4.2",
        "picomatch": "4.0.4"
    }
}
